{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analects book",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "book", "passages"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^analects\\.book\\.[0-9]{2}$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chinese"],
          "properties": {
            "chinese": { "type": "string", "minLength": 1 },
            "pinyin": { "type": "string", "minLength": 1 },
            "english": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./passage.schema.json"
      }
    }
  }
}
